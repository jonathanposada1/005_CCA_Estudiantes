# === LLM provider (Ollama, local) ===
# aisuite model string: "<provider>:<model-name>"
# NOTE: uses provider key "openai" (not "ollama") because the installed aisuite
# version's native ollama provider is buggy (calls /api/chat with incompatible
# params). The code instead routes the "openai" provider's real OpenAI SDK to
# Ollama's own OpenAI-compatible /v1 endpoint (see src/agents.py). This means
# the "openai" slot is dedicated to local Ollama for now.
LLM_MODEL=openai:deepseek-r1:1.5b 

# Request timeout (seconds) for calls to Ollama. Local models can be much
# slower than cloud APIs, especially for long report generations; aisuite's
# default is only 30s, which is usually too short. The writer/editor agents
# send large contexts (accumulated research + draft) and ask for 2400+ word
# reports, which can take several minutes on modest local hardware. Increase
# further if you still see "timed out" errors.
OLLAMA_TIMEOUT=900

# Where Ollama's API is reachable FROM INSIDE THE CONTAINER.
# Verified default: run the container with --network host (Linux) so 127.0.0.1
# inside the container is the same as the host's 127.0.0.1 (works even though
# Ollama binds only to 127.0.0.1 by default):
OLLAMA_API_URL=http://127.0.0.1:11434
#
# Alternative (no --network host): use --add-host=host.docker.internal:host-gateway
# AND make Ollama listen on all interfaces on the host (systemctl edit ollama,
# set Environment="OLLAMA_HOST=0.0.0.0", then restart the service). Then:
#     OLLAMA_API_URL=http://host.docker.internal:11434
# Without that host-side change, host.docker.internal will get "connection refused"
# because Ollama only listens on 127.0.0.1 by default.

# === Search tool (required by research_agent) ===
TAVILY_API_KEY=your-tavily-api-key

# === Database (Postgres, started inside the container) ===
# Leave unset to use the entrypoint's default: postgresql://app:local@127.0.0.1:5432/appdb
# DATABASE_URL=postgresql://app:local@127.0.0.1:5432/appdb
# POSTGRES_USER=app
# POSTGRES_PASSWORD=local
# POSTGRES_DB=appdb

# === Optional: reconnect to OpenAI later (unused while LLM_MODEL=ollama:...) ===
# OPENAI_API_KEY=your-openai-api-key
